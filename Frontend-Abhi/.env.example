# SignSight Frontend Environment Variables Example

# The base URL for API requests.
# In local development with Vite dev proxy, use '/api' to proxy requests to localhost:8000.
# In production, set to your backend API URL, e.g. 'https://api.signsight.example.com/api' or '/api' if hosted behind a reverse proxy.
VITE_API_BASE_URL=/api

# Target URL for the Vite development proxy (used when VITE_API_BASE_URL is '/api')
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Optional Google OAuth Client ID for "Sign in with Google" button.
# If left empty, the Google Sign-in button is cleanly hidden in the UI.
VITE_GOOGLE_CLIENT_ID=

# Polling interval in milliseconds for live alert checks (default 5000)
VITE_POLL_INTERVAL_MS=5000

# Optional API version prefix if your backend uses '/api/v1' instead of '/api'
VITE_API_VERSION_PREFIX=
