# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DATABASE_URL=postgres://signsight:signsight@db:5432/signsight

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_HOURS=24

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML Artifacts
ML_ARTIFACTS_DIR=ml_artifacts
ACTIVE_MODEL_CONFIG=ml_artifacts/active_model.json

# Dataset
DEFAULT_DATASET_PATH=data/nsl_kdd/KDDTest+.csv

# Notifications (optional — leave empty to disable)
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Sentry (optional)
SENTRY_DSN=

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
